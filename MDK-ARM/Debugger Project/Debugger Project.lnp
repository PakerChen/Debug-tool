--cpu Cortex-M3
"debugger project\startup_stm32f103xe.o"
"debugger project\main.o"
"debugger project\gpio.o"
"debugger project\usart.o"
"debugger project\stm32f1xx_it.o"
"debugger project\stm32f1xx_hal_msp.o"
"debugger project\stm32f1xx_hal_gpio_ex.o"
"debugger project\stm32f1xx_hal_uart.o"
"debugger project\stm32f1xx_hal.o"
"debugger project\stm32f1xx_hal_rcc.o"
"debugger project\stm32f1xx_hal_rcc_ex.o"
"debugger project\stm32f1xx_hal_gpio.o"
"debugger project\stm32f1xx_hal_dma.o"
"debugger project\stm32f1xx_hal_cortex.o"
"debugger project\stm32f1xx_hal_pwr.o"
"debugger project\stm32f1xx_hal_flash.o"
"debugger project\stm32f1xx_hal_flash_ex.o"
"debugger project\stm32f1xx_hal_exti.o"
"debugger project\system_stm32f1xx.o"
"debugger project\ringbuffer.o"
"debugger project\usart2.o"
"debugger project\usart1.o"
"debugger project\usart3.o"
--strict --scatter "Debugger Project\Debugger Project.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "Debugger Project.map" -o "Debugger Project\Debugger Project.axf"